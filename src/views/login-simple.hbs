<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Gestor Bancario</title>
    <link rel="stylesheet" href="/css/auth.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
</head>
<body class="auth-body">
    <div class="auth-container">
        <div class="login-form">
            <div class="login-header">
                <h1>Gestor Bancario</h1>
                <h2>Iniciar Sesión</h2>
                <p>Ingresa tus credenciales para acceder</p>
            </div>
            
            <!-- Credenciales de Demostracion -->
            <div class="demo-credentials">
                <h3>🎭 Credenciales de Prueba</h3>
                <div class="demo-users">
                    <div class="demo-user" onclick="llenarCredenciales('admin', '1234')">
                        <strong>👨‍💼 Administrador</strong>
                        <small>admin / 1234</small>
                    </div>
                    <div class="demo-user" onclick="llenarCredenciales('demo', 'demo123')">
                        <strong>👤 Usuario Demo</strong>
                        <small>demo / demo123</small>
                    </div>
                    <div class="demo-user" onclick="llenarCredenciales('dayhana', 'dayhana123')">
                        <strong>👩‍💻 Dayhana Acevedo</strong>
                        <small>dayhana / dayhana123</small>
                    </div>
                </div>
            </div>
            
            <form id="formularioLogin" class="auth-form">
                <div id="mensajeError" class="error-message" style="display: none;"></div>
                <div id="mensajeExito" class="success-message" style="display: none;"></div>
                
                <div class="form-group">
                    <label for="inputUsuario">
                        <i class="fas fa-user"></i>
                        Usuario
                    </label>
                    <input type="text" id="inputUsuario" name="usuario" required>
                </div>
                
                <div class="form-group">
                    <label for="inputPassword">
                        <i class="fas fa-lock"></i>
                        Contraseña
                    </label>
                    <input type="password" id="inputPassword" name="password" required>
                </div>
                
                <button type="submit" class="btn-primary" id="botonLogin">
                    <i class="fas fa-sign-in-alt"></i>
                    Iniciar Sesión
                </button>
            </form>
            
            <div class="auth-footer">
                <p>¿No tienes una cuenta? <a href="/registro">Regístrate aquí</a></p>
            </div>
        </div>
    </div>

    <script>
    // Configuración dinámica del backend
    const API_BASE_URL = '{{API_BASE_URL}}';
    
    // Función para llenar credenciales automáticamente
    function llenarCredenciales(usuario, password) {
        document.getElementById('inputUsuario').value = usuario;
        document.getElementById('inputPassword').value = password;
        
        // Mostrar mensaje
        const mensajeExito = document.getElementById('mensajeExito');
        mensajeExito.textContent = 'Credenciales cargadas. Haz clic en "Iniciar Sesión"';
        mensajeExito.style.display = 'block';
        
        setTimeout(() => {
            mensajeExito.style.display = 'none';
        }, 3000);
    }

    // Manejar el envío del formulario
    document.getElementById('formularioLogin').addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const usuario = document.getElementById('inputUsuario').value;
        const password = document.getElementById('inputPassword').value;
        const mensajeError = document.getElementById('mensajeError');
        const mensajeExito = document.getElementById('mensajeExito');
        const botonLogin = document.getElementById('botonLogin');
        
        // Limpiar mensajes anteriores
        mensajeError.style.display = 'none';
        mensajeExito.style.display = 'none';
        
        // Debug: verificar valores
        console.log('Valores del formulario:', { usuario, password });
        
        // Validación básica
        if (!usuario || !password) {
            console.log('Validación falló:', { usuario: !!usuario, password: !!password });
            mensajeError.textContent = 'Usuario y contraseña son requeridos';
            mensajeError.style.display = 'block';
            return;
        }
        
        botonLogin.disabled = true;
        botonLogin.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Iniciando sesión...';
        
        // Credenciales demostracion válidas (modo offline)
        const credencialesDemo = [
            { usuario: 'admin', password: '1234', nombre: 'Administrador', rol: 'admin' },
            { usuario: 'demo', password: 'demo123', nombre: 'Usuario Demo', rol: 'user' },
            { usuario: 'dayhana', password: 'dayhana123', nombre: 'Dayhana Acevedo', rol: 'user' }
        ];
        
        setTimeout(() => {
            // Verificar credenciales demostracion
            const usuarioValido = credencialesDemo.find(cred => 
                cred.usuario === usuario && cred.password === password
            );
            
            if (usuarioValido) {
                // Guardar datos del usuario en localStorage
                const userData = {
                    id: Math.floor(Math.random() * 1000),
                    usuario: usuarioValido.usuario,
                    nombre: usuarioValido.nombre,
                    rol: usuarioValido.rol,
                    modoDemo: true
                };
                
                localStorage.setItem('usuario', JSON.stringify(userData));
                
                mensajeExito.textContent = '✅ Inicio de sesión exitoso. Redirigiendo...';
                mensajeExito.style.display = 'block';
                
                // Redirigir al dashboard
                setTimeout(() => {
                    window.location.href = '/dashboard';
                }, 1000);
            } else {
                mensajeError.textContent = '❌ Credenciales inválidas. Usa: admin/1234, demo/demo123 o dayhana/dayhana123';
                mensajeError.style.display = 'block';
            }
            
            botonLogin.disabled = false;
            botonLogin.innerHTML = '<i class="fas fa-sign-in-alt"></i> Iniciar Sesión';
        }, 800);
    });
</script>    <style>
    .demo-credentials {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 1.5rem;
        border-radius: 12px;
        margin-bottom: 2rem;
        text-align: center;
    }

    .demo-credentials h3 {
        margin-bottom: 1rem;
        font-size: 1.1rem;
    }

    .demo-users {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .demo-user {
        background: rgba(255, 255, 255, 0.2);
        padding: 1rem;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
        backdrop-filter: blur(10px);
        min-width: 150px;
    }

    .demo-user:hover {
        background: rgba(255, 255, 255, 0.3);
        transform: translateY(-2px);
    }

    .demo-user strong {
        display: block;
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
    }

    .demo-user small {
        font-size: 0.8rem;
        opacity: 0.9;
        font-family: 'Courier New', monospace;
        background: rgba(0, 0, 0, 0.2);
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        display: inline-block;
    }

    @media (max-width: 480px) {
        .demo-users {
            flex-direction: column;
            align-items: center;
        }
        
        .demo-user {
            width: 100%;
            max-width: 200px;
        }
    }
    </style>
</body>
</html>